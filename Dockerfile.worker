# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# Worker (pg-boss job processor)
#
# Single-stage: bun installs production deps and runs scripts/worker.ts directly.
# No build step needed — bun runs TypeScript natively.
# ─────────────────────────────────────────────────────────────────────────────

FROM oven/bun:1.3.14
WORKDIR /app

# Install deps first for layer caching
COPY package.json bun.lock ./
RUN bun install --production --frozen-lockfile --ignore-scripts

# Copy source
COPY . .

ENV NODE_ENV=production

CMD ["bun", "--conditions", "react-server", "scripts/worker.ts"]
