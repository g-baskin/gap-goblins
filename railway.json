{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "node .next/standalone/server.js",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30,
    "overlapSeconds": 30,
    "drainingSeconds": 15
  }
}
