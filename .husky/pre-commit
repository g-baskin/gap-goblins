bunx lint-staged

# Secret-pattern scan on staged diff. Fails commit if a known secret shape appears.
# Patterns: Anthropic, Stripe, Resend, webhook secrets, Postgres URLs with creds,
# AWS access keys, Google API keys, JWT shape.
secret_patterns='(sk-(ant|live|test)-[A-Za-z0-9_-]{20,}|re_[A-Za-z0-9_-]{20,}|whsec_[A-Za-z0-9]{20,}|postgresql:'
secret_patterns="${secret_patterns}"'//[^[:space:]]+:[^[:space:]@]+@|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{20,}|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,})'

if git diff --cached --no-color | grep '^+' | grep -v '^+++' | grep -nE "$secret_patterns"; then
  echo "❌ Potential secret detected in staged diff. Remove before committing."
  exit 1
fi
