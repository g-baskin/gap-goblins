{
  "name": "gap-goblins",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "next dev --port 3510",
    "hermes:setup": "python3 scripts/hermes.py setup",
    "hermes:install": "python3 scripts/hermes.py install",
    "hermes:status": "python3 scripts/hermes.py status",
    "hermes:preview": "python3 scripts/hermes.py preview",
    "hermes:test": "python3 scripts/hermes.py test",
    "build": "next build",
    "build:verify": "bun scripts/verify-production-build.ts",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "analyze:server": "cross-env ANALYZE=server next build --webpack",
    "analyze:client": "cross-env ANALYZE=client next build --webpack",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "husky",
    "worker": "bun --conditions react-server scripts/worker.ts",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun --env-file=.env.local scripts/seed-crm-pipeline.ts"
  },
